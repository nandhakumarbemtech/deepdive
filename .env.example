# --- required ---------------------------------------------------------------
MESH_API_KEY=rsk_your_key_here

# --- model chains: first = preferred, rest = automatic fallbacks (confirm ids in the Mesh dashboard) ---
MODELS_PLANNER=openai/gpt-4o-mini,openai/gpt-4o
MODELS_RESEARCHER=openai/gpt-4o-mini,openai/gpt-4o
MODELS_WRITER=openai/gpt-4o,openai/gpt-4o-mini
MODELS_VERIFIER=anthropic/claude-sonnet-4.5,openai/gpt-4o
MODELS_AUDITOR=openai/gpt-4o,anthropic/claude-sonnet-4.5

# --- cost and safety guardrails (per run) -------------------------------------
MAX_COST_USD_PER_RUN=1.50
MAX_LLM_CALLS_PER_RUN=250
RUN_TIMEOUT_S=900
# Override approximate prices (USD per 1M tokens: [input, output]) if Mesh differs:
# PRICES_JSON={"openai/gpt-4o":[2.5,10.0]}

# --- search failover: tried in order; keyed providers are skipped when no key is set ----
SEARCH_PROVIDERS=ddgs,brave,tavily,wikipedia
# BRAVE_API_KEY=
# TAVILY_API_KEY=
FETCH_ARCHIVE_FALLBACK=1        # try the Internet Archive snapshot when a page cannot be fetched directly

# --- transparency ---------------------------------------------------------------
STORE_LLM_IO=1                  # keep every prompt and answer so it can be read in the UI (set 0 for sensitive data)

# --- latency / concurrency ----------------------------------------------------------
PARALLEL_WORKERS=5              # sub-questions processed at once (1 = sequential)
MAX_INFLIGHT_LLM=6              # process-wide cap on simultaneous model requests
FETCH_CACHE_TTL_S=3600          # 0 disables the page cache

# --- service ------------------------------------------------------------------
# DEEPDIVE_API_KEY=change-me      # if set, every /api call needs header X-API-Key
MAX_CONCURRENT_RUNS=2
RATE_LIMIT_PER_MIN=10